APP_NAME=CareReady API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://careready:local-development-only@127.0.0.1:5434/careready
REDIS_URL=redis://127.0.0.1:6382/0

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=2

# CH13: browser origins include scheme and port; hosts are names only.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Local-only Chapter 14 mail catcher
MAIL_PORT=1027
PUBLIC_BASE_URL=http://127.0.0.1:8002
MAIL_LINK_SECONDS=3600
